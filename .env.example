# TN-MCPs environment variables — NAMES AND DESCRIPTIONS ONLY.
#
# Never put a real value in this file. Copy it to `.env` (gitignored) for local
# development only, with throwaway values. In production on the A1 VM, non-secret
# values live in /etc/tn-mcps/gateway.env and secrets live in permissioned files
# whose PATHS are passed via *_FILE variables (see docs/DEPLOYMENT_A1.md and
# docs/SECURITY.md §3). Variables marked [Phase N] are not read by any code yet.

# --- Runtime -----------------------------------------------------------------
# Deployment environment: development | test | production
NODE_ENV=
# Minimum log level: fatal | error | warn | info | debug | trace
TN_LOG_LEVEL=

# --- MCP gateway (servers/gateway) ---------------------------------- [Phase 2]
# Loopback address the gateway binds to. Must stay 127.0.0.1 in production;
# cloudflared connects to it locally. Never 0.0.0.0.
TN_MCP_HOST=
# Loopback port for the gateway (planned: 8787; check `ss -tlnp` first).
TN_MCP_PORT=
# Canonical public MCP URL, used for Host/Origin validation and as the resource
# identifier. Planned: https://mcp.telosnexus.cloud/mcp
TN_MCP_PUBLIC_URL=
# Comma-separated provider list to enable (e.g. "cloudflare"). Empty = none.
TN_PROVIDERS=

# --- Policy / audit / approvals ------------------------------------- [Phase 3]
# Directory for the append-only audit log (outside the repo, e.g. /var/lib/tn-mcps/audit).
TN_AUDIT_DIR=
# Path to a file holding the HMAC key used to chain audit records.
TN_AUDIT_HMAC_KEY_FILE=
# Path to the approvals store (outside the repo, e.g. /var/lib/tn-mcps/approvals.sqlite).
TN_APPROVALS_DB=

# --- Inbound authentication (Cloudflare Access) --------------------- [Phase 4]
# Cloudflare Zero Trust team domain, e.g. https://<team>.cloudflareaccess.com
# Used to fetch the Access JWKS for verifying Cf-Access-Jwt-Assertion.
TN_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag of the Access application protecting the gateway.
TN_ACCESS_AUD=
# Comma-separated allowlist of human identities (emails) permitted to call tools.
TN_ALLOWED_EMAILS=
# Comma-separated allowlist of Access service-token client IDs (machine clients such
# as Jarvis). IDs only; the secrets stay with the clients.
TN_ALLOWED_SERVICE_TOKEN_IDS=

# --- Cloudflare provider (outbound) --------------------------------- [Phase 5]
# Cloudflare account ID the provider operates on (not secret, but not committed).
CLOUDFLARE_ACCOUNT_ID=
# Path to the file holding Token A: read-only, IP-filtered (curated read tools).
CLOUDFLARE_API_TOKEN_READ_FILE=
# Path to the file holding Token B: read-only, no IP filter (upstream Cloudflare API MCP).
CLOUDFLARE_API_TOKEN_READ_UPSTREAM_FILE=
# Upstream Cloudflare API MCP endpoint (default: https://mcp.cloudflare.com/mcp)
CLOUDFLARE_MCP_URL=

# --- Cloudflare controlled writes ----------------------------------- [Phase 9]
# Path to the file holding Token C: scoped write token. Leave unset until Phase 9 is
# approved; the gateway runs read-only without it.
CLOUDFLARE_API_TOKEN_WRITE_FILE=
