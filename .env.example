# TN-MCPs environment variables — NAMES AND DESCRIPTIONS ONLY.
#
# Never put a real value in this file. Copy the section you need into a local `.env`
# (gitignored) for development, with throwaway values only.
#
# In production every process has its own file, /etc/tn-mcps/<process>/<process>.env,
# readable only by that process's user. It holds non-secret values plus *_FILE paths.
# Secret values live in sibling files in the same directory, never in env files (see
# docs/DEPLOYMENT_A1.md §2 and docs/SECURITY.md §3). Because each process reads only
# its own file, the same variable names repeat per process. Default ports come from
# packages/config (gateway 8790, cloudflare 8701, github 8702, oracle 8703,
# telos-control 8704); override TN_PORT only for tests.
# Variables marked [Phase N] are not read by any code yet.

# === Common to every process ======================================= [Phase 2]
# Deployment environment: development | test | production
NODE_ENV=
# Minimum log level: fatal | error | warn | info | debug | trace
TN_LOG_LEVEL=
# Bind address. Must be a loopback address; any other value is rejected.
TN_BIND_HOST=
# Override of the process's central default port (tests only).
TN_PORT=
# Authentication mode: access | dev. `dev` is refused unless NODE_ENV=development
# and TN_PUBLIC_BASE_URL is unset or a loopback URL. Production is always `access`.
TN_AUTH_MODE=
# Path to the local development token file (dev mode only; mode 0600).
TN_DEV_TOKEN_FILE=
# Public base URL, used for Host/Origin validation and resource identifiers.
# Planned: https://mcp.telosnexus.cloud
TN_PUBLIC_BASE_URL=

# === Access verification (gateway and every MCP server) ============= [Phase 4]
# Cloudflare Zero Trust team domain, e.g. https://<team>.cloudflareaccess.com
TN_ACCESS_TEAM_DOMAIN=
# Expected Application Audience (AUD) tag. In an MCP server's file: its own path's AUD.
# The gateway uses TN_ACCESS_AUD_<ROUTE> per route (below).
TN_ACCESS_AUD=
# Comma-separated allowlist of human identities (emails).
TN_ALLOWED_EMAILS=
# Comma-separated allowlist of Access service-token client IDs (e.g. JARVIS).
# IDs only; the secrets stay with the clients.
TN_ALLOWED_SERVICE_TOKEN_IDS=

# === Gateway only (gateway.env) ================================ [Phase 2-8]
# Per-route expected AUD tags, verified before proxying.
TN_ACCESS_AUD_CLOUDFLARE=
TN_ACCESS_AUD_GITHUB=
TN_ACCESS_AUD_ORACLE=
TN_ACCESS_AUD_TELOS=
# Approvals app AUD (separate Access application, owner-only, MFA).      [Phase 8]
TN_ACCESS_AUD_APPROVALS=
# Approvals store (gateway is the only writer) and its Unix socket.      [Phase 3]
TN_APPROVALS_DB=
TN_APPROVALS_SOCKET=

# === Audit (every process, own chain) ============================== [Phase 3]
# This process's audit directory, e.g. /var/lib/tn-mcps/audit/<process>
TN_AUDIT_DIR=
# Path to this process's HMAC key file for the audit chain.
TN_AUDIT_HMAC_KEY_FILE=

# === Cloudflare MCP only (cloudflare.env) ========================== [Phase 5]
# Cloudflare account ID (not secret, but not committed).
CLOUDFLARE_ACCOUNT_ID=
# Path to Token A: read-only, IP-filtered (curated R0 tools).
CLOUDFLARE_API_TOKEN_READ_FILE=
# Path to Token B: read-only, no IP filter (upstream Cloudflare API MCP adapter).
CLOUDFLARE_API_TOKEN_READ_UPSTREAM_FILE=
# Upstream Cloudflare API MCP endpoint (default: https://mcp.cloudflare.com/mcp)
CLOUDFLARE_MCP_URL=
# Enable cf_api_execute (default false; every call still needs an exact-code owner approval).
CLOUDFLARE_API_EXECUTE_ENABLED=
# Path to Token C: scoped write token. Unset until Phase 9 is approved.     [Phase 9]
CLOUDFLARE_API_TOKEN_WRITE_FILE=
