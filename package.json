{
  "name": "tn-mcps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "guard": "node scripts/guard-secrets.mjs",
    "check": "biome ci . && tsc -b && vitest run && node scripts/guard-secrets.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "26.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
