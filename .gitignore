*.sqlite-*
*.db
*.log

# Local Claude Code / agent state
.claude/settings.local.json
.claude/*.local.*
.delegate/

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
